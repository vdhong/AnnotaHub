#: comments/views.py:108
msgid "Đã có lỗi xảy ra. Quản trị viên đã được thông báo."
msgstr "Something went wrong. The administrators have been notified."

#: comments/views.py:154
msgid "Bạn đã thử đăng nhập quá nhiều lần. Vui lòng đợi vài phút rồi thử lại."
msgstr "Too many login attempts. Please wait a few minutes and try again."

#: comments/views.py:168
msgid "Tên đăng nhập hoặc mật khẩu không đúng."
msgstr "Username or password is incorrect."

#: comments/views.py:177
msgid "Bạn đã đăng xuất thành công."
msgstr "You have logged out successfully."

#: comments/views.py:187
msgid "Bạn đã đăng ký quá nhiều lần. Vui lòng thử lại sau."
msgstr "Too many registration attempts. Please try again later."

#: comments/views.py:199 comments/views.py:341
msgid "Tên đăng nhập là bắt buộc."
msgstr "Username is required."

#: comments/views.py:201
msgid "Tên đăng nhập phải có ít nhất 3 ký tự."
msgstr "Username must be at least 3 characters."

#: comments/views.py:203
msgid "Tên đăng nhập phải có tối đa 150 ký tự."
msgstr "Username must be at most 150 characters."

#: comments/views.py:205 comments/views.py:343
#, python-format
msgid "Tên đăng nhập \"%(username)s\" đã được sử dụng."
msgstr "Username \"%(username)s\" is already in use."

#: comments/views.py:208
msgid "Họ và tên là bắt buộc."
msgstr "Full name is required."

#: comments/views.py:211
msgid "Địa chỉ email là bắt buộc."
msgstr "Email address is required."

#: comments/views.py:213
#, python-format
msgid "Địa chỉ email \"%(email)s\" đã được đăng ký."
msgstr "Email address \"%(email)s\" is already registered."

#: comments/views.py:216 comments/views.py:345
msgid "Mật khẩu là bắt buộc."
