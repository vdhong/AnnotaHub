#: templates/comments/accept_invitation.html:3
#: templates/comments/accept_invitation.html:10
#: templates/comments/accept_invitation.html:70
msgid "Complete Registration"
msgstr "Hoàn tất đăng ký"

#: templates/comments/accept_invitation.html:15
#, python-format
msgid ""
"Hello! <strong>%(inviter_name)s</strong> has invited you to join the project "
"<strong>%(project_name)s</strong> on AnnotaHub."
msgstr ""
"Xin chào! <strong>%(inviter_name)s</strong> đã mời bạn tham gia dự án "
"<strong>%(project_name)s</strong> trên AnnotaHub."

#: templates/comments/accept_invitation.html:16
msgid ""
"Please fill in the information below to complete registration and auto-login."
msgstr ""
"Vui lòng điền thông tin bên dưới để hoàn tất đăng ký và tự động đăng nhập."

#: templates/comments/accept_invitation.html:32
#: templates/comments/login.html:516 templates/comments/register.html:444
msgid "Username"
msgstr "Tên đăng nhập"

#: templates/comments/accept_invitation.html:35
msgid "Username must be unique."
msgstr "Tên đăng nhập phải là duy nhất."

#: templates/comments/accept_invitation.html:39
#: templates/comments/project_participants.html:52
#: templates/comments/register.html:491
msgid "Email"
msgstr "Email"

#: templates/comments/accept_invitation.html:41
msgid "Email cannot be changed."
msgstr "Email không thể thay đổi."

#: templates/comments/accept_invitation.html:46
#: templates/comments/register.html:462
msgid "First Name"
msgstr "Tên"

#: templates/comments/accept_invitation.html:51
#: templates/comments/register.html:475
msgid "Last Name"
