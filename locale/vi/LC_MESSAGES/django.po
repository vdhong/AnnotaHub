msgstr "Mật khẩu phải có ít nhất 8 ký tự."

#: templates/comments/accept_invitation.html:64
#: templates/comments/register.html:531
msgid "Confirm Password"
msgstr "Xác nhận mật khẩu"

#: templates/comments/accept_invitation.html:77
msgid "Important"
msgstr "Quan trọng"

#: templates/comments/accept_invitation.html:77
msgid ""
"After completing registration, please refresh the page or navigate to "
"another page to ensure successful login."
msgstr ""
"Sau khi hoàn tất đăng ký, vui lòng tải lại trang hoặc chuyển sang trang khác "
"để đảm bảo đăng nhập thành công."

#: templates/comments/accept_invitation.html:93
