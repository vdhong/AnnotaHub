#: comments/services/email_verification_service.py:37
msgid "Email Verification - AnnotaHub"
msgstr "Xác thực Email - AnnotaHub"

#: comments/services/email_verification_service.py:39
#, python-brace-format
msgid ""
"Hello,\n"
"\n"
"Thank you for registering an account on AnnotaHub.\n"
"\n"
"Please click the link below to verify your email address:\n"
"\n"
"{verification_link}\n"
"\n"
"This link will expire in 7 days.\n"
"\n"
"Best regards,\n"
"\n"
"The AnnotaHub Team"
msgstr ""
"Xin chào,\n"
"\n"
"Cảm ơn bạn đã đăng ký tài khoản trên AnnotaHub.\n"
"\n"
"Vui lòng nhấn vào liên kết bên dưới để xác thực địa chỉ email của bạn:\n"
"\n"
"{verification_link}\n"
"\n"
"Liên kết này sẽ hết hạn sau 7 ngày.\n"
"\n"
"Trân trọng,\n"
"\n"
"Đội ngũ AnnotaHub"

