# ===========================================================================
# AnnotaHub — mẫu cấu hình môi trường
# Sao chép thành .env rồi điền giá trị thật. TUYỆT ĐỐI không commit file .env.
# ===========================================================================

# --- BẮT BUỘC: Django ------------------------------------------------------
# Sinh khoá mới:
#   docker compose run --rm --entrypoint python web -c \
#     "import secrets,string; a=string.ascii_letters+string.digits+'-_.~'; \
#      print(''.join(secrets.choice(a) for _ in range(64)))"
# Lưu ý: tránh ký tự $ vì Docker Compose sẽ hiểu là biến.
# Ứng dụng TỪ CHỐI khởi động nếu khoá còn là giá trị mẫu và DEBUG=0.
SECRET_KEY=

# DEBUG mặc định TẮT. Chỉ đặt 1 ở máy phát triển.
# KHÔNG BAO GIỜ đặt 1 trên máy chủ thật: trang lỗi sẽ lộ mã nguồn và cấu hình.
DEBUG=0

# Liệt kê tên miền cụ thể. Giá trị '*' bị từ chối khi DEBUG=0.
ALLOWED_HOSTS=localhost,127.0.0.1

# Nguồn gốc được tin cậy cho CSRF (phải có scheme http:// hoặc https://)
CSRF_TRUSTED_ORIGINS=http://localhost:6868

# URL gốc dùng để dựng link trong email mời / xác thực
SITE_URL=http://localhost:6868

# --- BẮT BUỘC: Cơ sở dữ liệu ----------------------------------------------
POSTGRES_DB=annotahub
POSTGRES_USER=annotahub_user
# Sinh mật khẩu ngẫu nhiên, KHÔNG dùng lại giá trị mẫu:
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
POSTGRES_PASSWORD=

# --- BẮT BUỘC: Mã hoá API key lưu trong DB --------------------------------
# Sinh khoá Fernet:
#   python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Để trống => API key lưu KHÔNG mã hoá (chỉ chấp nhận ở môi trường dev).
# ĐỔI KHOÁ NÀY SẼ LÀM MẤT các API key đã lưu — phải nhập lại.
FIELD_ENCRYPTION_KEY=

# --- Tích hợp ngoài (tuỳ chọn, có thể đặt riêng cho từng người dùng trong UI)
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=

# --- HTTPS (BẬT KHI ĐÃ CÓ REVERSE PROXY / CHỨNG CHỈ) ----------------------
# Bật cả 4 dòng dưới đây thì `manage.py check --deploy` sẽ sạch hoàn toàn.
# CẢNH BÁO: bật khi CHƯA có HTTPS sẽ khiến không đăng nhập được (cookie bị chặn).
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
# 31536000 = 1 năm. Chỉ bật khi chắc chắn toàn site chạy HTTPS vĩnh viễn:
# HSTS không thể thu hồi nhanh ở phía trình duyệt.
SECURE_HSTS_SECONDS=0

# --- Email (mời thành viên, xác thực tài khoản) ---------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Hiệu năng gán nhãn ----------------------------------------------------
# Số bình luận mỗi batch Celery. Nhỏ = tiến độ mượt hơn, lớn = ít overhead hơn.
ANNOTATION_BATCH_SIZE=50
# Nhiệt độ LLM. 0 = kết quả tái lập được (khuyến nghị cho gán nhãn).
ANNOTATION_LLM_TEMPERATURE=0

# --- Log -------------------------------------------------------------------
DJANGO_LOG_LEVEL=WARNING
APP_LOG_LEVEL=INFO
